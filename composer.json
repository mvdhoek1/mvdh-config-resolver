{
    "name": "mvdh/config-resolver",
    "description": "Utility to resolve and search values in nested configuration arrays.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "pestphp/pest": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "MVDH\\ConfigResolver\\": "src/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
